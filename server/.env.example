# ===== Vercel KV (create at https://vercel.com -> Storage -> KV) =====
# KV_REST_API_URL and KV_REST_API_TOKEN are used in production on Vercel.
# Leave blank to run the API locally against a JSON file (server/data/db.json).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ===== Vercel Blob (create at https://vercel.com -> Storage -> Blob) =====
# Only needed by scripts/seed.mjs to upload avatars/material files.
BLOB_READ_WRITE_TOKEN=

# ===== Auth =====
JWT_SECRET=change-this-to-a-long-random-string
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=2592000

# ===== Seed / initial admin account =====
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=cdaradmin

# Default password assigned to all existing (seed) users.
DEFAULT_PASSWORD=Cdar@2024